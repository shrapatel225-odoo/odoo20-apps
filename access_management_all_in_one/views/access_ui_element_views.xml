<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="access_ui_element_view_list" model="ir.ui.view">
        <field name="name">access.ui.element.list</field>
        <field name="model">access.ui.element</field>
        <field name="arch" type="xml">
            <list string="UI Elements" editable="bottom">
                <field name="model_id" options="{'no_create': True}"/>
                <field name="kind"/>
                <field name="key"/>
                <field name="label"/>
                <field name="view_types" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="access_ui_element_view_search" model="ir.ui.view">
        <field name="name">access.ui.element.search</field>
        <field name="model">access.ui.element</field>
        <field name="arch" type="xml">
            <search>
                <field name="model_id"/>
                <field name="key"/>
                <field name="label"/>
                <filter name="group_model" string="Model" context="{'group_by': 'model_id'}"/>
                <filter name="group_kind" string="Type" context="{'group_by': 'kind'}"/>
            </search>
        </field>
    </record>

    <record id="action_access_ui_element" model="ir.actions.act_window">
        <field name="name">UI Elements</field>
        <field name="res_model">access.ui.element</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_model': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No element scanned yet</p>
            <p>Open an access profile and click "Scan Views" to list the buttons, tabs, links and filters of its models.</p>
        </field>
    </record>
</odoo>
