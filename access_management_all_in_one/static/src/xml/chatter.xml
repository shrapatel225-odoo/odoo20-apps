<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.Chatter" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o-mail-Chatter-sendMessage')]" position="attributes">
            <attribute name="t-if">!this.accessSuiteHides('hide_send_message')</attribute>
        </xpath>
        <xpath expr="//button[hasclass('o-mail-Chatter-logNote')]" position="attributes">
            <attribute name="t-if">!this.accessSuiteHides('hide_log_note')</attribute>
        </xpath>
        <xpath expr="//button[hasclass('o-mail-Chatter-activity')]" position="attributes">
            <attribute name="t-if">this.webChatterProps.has_activities and !this.accessSuiteHides('hide_activity')</attribute>
        </xpath>
    </t>
</templates>
