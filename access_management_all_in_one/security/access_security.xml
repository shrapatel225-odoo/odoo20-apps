<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_access_suite" model="res.groups.privilege">
        <field name="name">Access Management</field>
        <field name="sequence">90</field>
        <field name="category_id" ref="base.module_category_administration"/>
    </record>

    <record id="group_access_suite_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_access_suite"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Can create and edit access profiles.</field>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_access_suite_manager'))]"/>
    </record>
</odoo>
